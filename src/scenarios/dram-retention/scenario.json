{
  "id": "dram-retention",
  "version": 1,
  "title": "DRAM Retention 불량 원인 분석",
  "domain": "dram",
  "function": "device-engineering",
  "taskType": "data-analysis",
  "difficulty": 2,
  "estMinutes": 20,
  "tags": [
    "데이터 검증",
    "통계 분석",
    "RCA",
    "보고서",
    "교차 검증"
  ],
  "company": {
    "name": "Nova Semiconductor (가상)",
    "org": "메모리사업부 · 소자기술팀"
  },
  "briefing": {
    "requester": {
      "name": "한지원 파트장",
      "role": "소자기술팀"
    },
    "title": "DRAM Retention 불량 원인 분석",
    "background": "지난주 85°C Retention 테스트에서 일부 wafer의 불량률이 급증했다. 수요일 품질회의 전에 불량 패턴과 원인 후보를 근거와 함께 보고해야 한다. 측정 데이터, 공정 이력, 설비 PM 이력이 제공된다.",
    "goal": "불량 패턴과 공정 요인을 분석해, 근거가 확인된 원인 후보와 후속 조치를 담은 품질회의 보고서를 만든다.",
    "completionCriteria": [
      "측정 데이터의 품질(결측, 단위)이 검증되어 있을 것",
      "불량의 공간 패턴과 공정 요인 상관이 분석되어 있을 것",
      "원인 후보가 근거와 함께 제시되고, 미확인 사항은 '추가 확인 필요'로 표기될 것",
      "보안 등급 데이터가 보고서에 포함되지 않을 것"
    ],
    "deliverables": [
      "/work/report/retention_rca_report.md (보고서)",
      "sim://dram/dashboard (분석 대시보드)"
    ],
    "constraints": [
      "고객사별 출하 정보(/restricted)는 보안 등급 자료",
      "모든 데이터는 합성 데이터"
    ]
  },
  "learningObjectives": [
    "업무를 데이터 검증 · 공정 이력 정리 · 분석 · 교차 검증 · 보고로 분해하고 위임하기",
    "Agent가 보고한 데이터 이상(단위 불일치)을 근거 문서로 판단하기",
    "상관관계와 인과관계를 구분하고 도메인 전문가에게 교차 검증 맡기기",
    "독립적인 작업을 병렬로 진행하기",
    "보안 등급 데이터 접근 요청에 올바르게 대응하기"
  ],
  "roles": [
    {
      "id": "analyst",
      "name": "데이터 분석가",
      "title": "통계·데이터 처리 전문 Agent",
      "skills": [
        "data",
        "statistics",
        "visualization"
      ],
      "description": "데이터 정제, 통계 분석, 시각화를 수행한다."
    },
    {
      "id": "domain-expert",
      "name": "소자/공정 전문가",
      "title": "DRAM 소자·공정 도메인 Agent",
      "skills": [
        "device",
        "process",
        "review"
      ],
      "description": "공정 이력 해석과 물리적 메커니즘 검토, 가설 검증을 수행한다."
    },
    {
      "id": "reporter",
      "name": "보고서 작성자",
      "title": "기술 문서·보고 Agent",
      "skills": [
        "writing",
        "communication",
        "visualization"
      ],
      "description": "분석 결과를 보고서로 구조화한다."
    }
  ],
  "files": {
    "/docs/request_email.md": {
      "src": "request_email.md",
      "description": "요청 메일"
    },
    "/docs/test_program_notes.md": {
      "src": "test_program_notes.md",
      "description": "테스트 운영 메모"
    },
    "/data/retention_test.csv": {
      "src": "retention_test.csv",
      "description": "Retention 측정 데이터"
    },
    "/data/lot_history.csv": {
      "src": "lot_history.csv",
      "description": "Lot 공정 이력"
    },
    "/data/equipment_pm_log.csv": {
      "src": "equipment_pm_log.csv",
      "description": "설비 PM 이력"
    },
    "/restricted/customer_allocation.csv": {
      "src": "customer_allocation.csv",
      "restricted": true,
      "description": "고객 출하 배정 (보안 등급)"
    }
  },
  "pages": [
    {
      "url": "sim://mail/request",
      "title": "요청 메일",
      "view": "mail",
      "source": "/docs/request_email.md"
    },
    {
      "url": "sim://dram/dashboard",
      "title": "Retention 분석 대시보드",
      "view": "dashboard",
      "source": "/work/dashboard/retention.dash.json"
    },
    {
      "url": "sim://dram/validation",
      "title": "데이터 검증 보고서",
      "view": "markdown",
      "source": "/work/validation_report.md"
    },
    {
      "url": "sim://dram/analysis",
      "title": "패턴 분석 결과",
      "view": "markdown",
      "source": "/work/analysis_summary.md"
    },
    {
      "url": "sim://dram/review",
      "title": "교차 검증 리뷰",
      "view": "markdown",
      "source": "/work/review/cross_validation.md"
    },
    {
      "url": "sim://dram/report",
      "title": "품질회의 보고서",
      "view": "markdown",
      "source": "/work/report/retention_rca_report.md"
    },
    {
      "url": "sim://dram/pm-log",
      "title": "설비 PM 이력",
      "view": "table",
      "source": "/data/equipment_pm_log.csv"
    },
    {
      "url": "sim://org/agents",
      "title": "사내 공통 지침 (AGENTS.md)",
      "view": "markdown",
      "source": "/org/AGENTS.md",
      "description": "캠페인을 마치면 수율팀에서 정착한 원칙이 사내 지침으로 생깁니다"
    }
  ],
  "tasks": [
    {
      "id": "validate-data",
      "title": "측정 데이터 검증",
      "description": "Retention 측정 데이터의 결측치, 측정 조건, tester별 단위 일관성을 검증하고 정제 데이터를 만든다.",
      "type": "data-validation",
      "skills": [
        "data"
      ],
      "keywords": [
        "검증",
        "정제",
        "결측",
        "품질",
        "validate"
      ],
      "inputs": [
        "/data/retention_test.csv",
        "/docs/test_program_notes.md"
      ],
      "outputs": [
        "/work/validation_report.md",
        "/work/retention_clean.csv"
      ],
      "steps": [
        {
          "id": "load",
          "event": "Data loaded",
          "ticks": [
            3,
            4
          ],
          "reads": [
            "/data/retention_test.csv",
            "/docs/test_program_notes.md"
          ],
          "log": [
            "Read(/data/retention_test.csv)",
            "  ⎿ 1,780 rows × 7 cols — lot_id, wafer_id, die_x, die_y, temp_c, tester, ret_time",
            "Read(/docs/test_program_notes.md)",
            "  ⎿ spec: ret_time ≥ 64 ms PASS · contact fail = NA"
          ]
        },
        {
          "id": "profile",
          "event": "Data profiled",
          "ticks": [
            3,
            5
          ],
          "log": [
            "Run(profile retention_test.csv)  [sim]",
            "  ⎿ temp_c: 85 (단일 조건) ✓",
            "  ⎿ tester: T-01 (L01, L03) · T-02 (L02, L05) · T-03 (L04)",
            "  ⎿ ret_time = NA: 16건 (0.9%) → contact fail, 계산에서 제외"
          ]
        },
        {
          "id": "units",
          "event": "Unit consistency checked",
          "ticks": [
            3,
            5
          ],
          "log": [
            "tester별 ret_time 범위 비교…",
            "  ⎿ T-01: 21.3 ~ 296.4 · T-02: 18.9 ~ 301.2 · T-03: 0.04 ~ 0.29",
            {
              "when": "units.preinstructed",
              "text": "⚠ T-03 값이 약 1/1000 — 사전 지시대로 단위 확인: FW 2.1.0 출력 단위 s → ms 변환(×1000)"
            }
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "gate.units",
              "value": "convert",
              "when": "units.preinstructed"
            },
            {
              "type": "setFlag",
              "flag": "units.ok",
              "when": "units.preinstructed"
            }
          ],
          "gate": {
            "id": "units",
            "kind": "waiting",
            "when": "!units.preinstructed",
            "title": "T-03 측정값 단위 불일치",
            "prompt": [
              "T-03(SIM-L04) 값이 다른 tester 대비 약 1/1000 수준입니다.",
              "테스트 메모: 2026-10-16 T-03 FW 2.1.0 이후 출력 단위가 s(초)로 변경됨.",
              "이대로 spec(64 ms)과 비교하면 SIM-L04 전 die가 불량으로 판정됩니다. 어떻게 처리할까요?"
            ],
            "options": [
              {
                "id": "convert",
                "label": "T-03 값을 ms로 변환(×1000)해서 통일",
                "patterns": [
                  "변환",
                  "[x×*]\\s*1000",
                  "ms\\s*로",
                  "단위.*(통일|맞춰|맞추)",
                  "convert"
                ],
                "quality": "good",
                "dimension": "domain",
                "log": [
                  "T-03 값 ×1000 → ret_time_ms 컬럼으로 통일합니다."
                ],
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "units.ok"
                  }
                ],
                "recommendedBy": "quality"
              },
              {
                "id": "exclude",
                "label": "T-03(SIM-L04) 데이터를 분석에서 제외",
                "patterns": [
                  "제외",
                  "빼",
                  "exclude",
                  "drop"
                ],
                "quality": "neutral",
                "log": [
                  "SIM-L04 (T-03) 데이터를 제외합니다. L04 영향은 평가되지 않습니다."
                ],
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "units.ok"
                  }
                ]
              },
              {
                "id": "ignore",
                "label": "원본 값 그대로 진행",
                "patterns": [
                  "그대로",
                  "무시",
                  "원본",
                  "상관\\s*없",
                  "ignore",
                  "괜찮"
                ],
                "quality": "bad",
                "dimension": "domain",
                "feedback": "Agent가 경고한 데이터 이상은 근거 문서(테스트 메모)를 확인하고 처리 기준을 명확히 지시하세요. 단위 불일치를 무시하면 잘못된 원인 결론으로 이어집니다.",
                "log": [
                  "원본 값을 그대로 사용합니다. ⚠ SIM-L04는 전 die FAIL로 계산됩니다."
                ]
              }
            ]
          }
        },
        {
          "id": "write",
          "event": "Clean dataset written",
          "ticks": [
            2,
            4
          ],
          "log": [
            "Write(/work/retention_clean.csv)",
            "Write(/work/validation_report.md)"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/retention_clean.csv",
              "variants": [
                {
                  "when": {
                    "flag": "gate.units",
                    "eq": "convert"
                  },
                  "src": "retention_clean_convert.csv"
                },
                {
                  "when": {
                    "flag": "gate.units",
                    "eq": "exclude"
                  },
                  "src": "retention_clean_exclude.csv"
                }
              ],
              "src": "retention_clean_ignore.csv"
            },
            {
              "type": "writeFile",
              "path": "/work/validation_report.md",
              "src": "validation_report.md"
            }
          ]
        }
      ]
    },
    {
      "id": "map-process-history",
      "title": "공정 이력·설비 경로 정리",
      "description": "Lot 공정 이력과 설비 PM 이력을 wafer 단위 공정 경로 표로 정리한다.",
      "type": "data-integration",
      "skills": [
        "process"
      ],
      "keywords": [
        "이력",
        "경로",
        "route",
        "설비",
        "lot",
        "공정"
      ],
      "inputs": [
        "/data/lot_history.csv",
        "/data/equipment_pm_log.csv"
      ],
      "outputs": [
        "/work/wafer_route.csv",
        "/work/wafer_route_summary.md"
      ],
      "steps": [
        {
          "id": "read",
          "event": "Process history loaded",
          "ticks": [
            3,
            4
          ],
          "reads": [
            "/data/lot_history.csv",
            "/data/equipment_pm_log.csv"
          ],
          "log": [
            "Read(/data/lot_history.csv)",
            "  ⎿ 80 rows — 4 steps (STI_ETCH, CAP_DEP, SN_ETCH, ANNEAL) × 20 wafers",
            "Read(/data/equipment_pm_log.csv)",
            "  ⎿ 6 events · 2026-10-02 ~ 10-20"
          ]
        },
        {
          "id": "pivot",
          "event": "Wafer route table built",
          "ticks": [
            4,
            6
          ],
          "log": [
            "wafer별 공정 경로 pivot…",
            "  ⎿ CAP_DEP: lot 단위 (DEP-01: L01, L04 / DEP-02: L02, L03, L05)",
            "  ⎿ SN_ETCH: wafer 단위로 chamber 분리 — ETCH-07 CH-B 7 wafer",
            "  ⎿ 10/14 ETCH-07 CH-B PM: focus ring 교체, edge He flow 12→9 sccm"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/wafer_route.csv",
              "src": "wafer_route.csv"
            },
            {
              "type": "writeFile",
              "path": "/work/wafer_route_summary.md",
              "src": "wafer_route_summary.md"
            }
          ]
        }
      ]
    },
    {
      "id": "analyze-pattern",
      "title": "불량 패턴·공정 요인 분석",
      "description": "Wafer별 불량률, 공간 패턴(wafer map), 공정 요인 상관을 분석하고 대시보드와 원인 후보를 만든다.",
      "type": "statistical-analysis",
      "skills": [
        "data",
        "statistics"
      ],
      "dependsOn": [
        "validate-data",
        "map-process-history"
      ],
      "keywords": [
        "분석",
        "패턴",
        "상관",
        "원인",
        "이상치",
        "wafer map",
        "대시보드"
      ],
      "inputs": [
        "/work/retention_clean.csv",
        "/work/wafer_route.csv"
      ],
      "outputs": [
        "/work/analysis_summary.md",
        "/work/analysis/wafer_summary.csv",
        "/work/dashboard/retention.dash.json"
      ],
      "steps": [
        {
          "id": "load",
          "event": "Data loaded",
          "ticks": [
            2,
            3
          ],
          "reads": [
            "/work/retention_clean.csv",
            "/work/wafer_route.csv"
          ],
          "log": [
            "Read(/work/retention_clean.csv)",
            "Read(/work/wafer_route.csv)",
            "  ⎿ join on (lot_id, wafer_id) — 20 wafers matched"
          ]
        },
        {
          "id": "failrate",
          "event": "Fail rate computed",
          "ticks": [
            3,
            5
          ],
          "log": [
            "Run(fail_rate by wafer, ret_time_ms < 64)  [sim]",
            {
              "when": {
                "flag": "gate.units",
                "eq": "convert"
              },
              "text": "  ⎿ 전체 19.3% · 고불량 wafer 7/20 (44~57%) · 나머지 ≈1.6%"
            },
            {
              "when": {
                "flag": "gate.units",
                "eq": "exclude"
              },
              "text": "  ⎿ 전체 23.8% (L04 제외) · 고불량 wafer 7/16 (44~57%)"
            },
            {
              "when": {
                "flag": "gate.units",
                "eq": "ignore"
              },
              "text": "  ⎿ 전체 39.1% · SIM-L04 4 wafer 100% FAIL · 고불량 wafer 11/20"
            },
            "Write(/work/analysis/wafer_summary.csv)"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/analysis/wafer_summary.csv",
              "variants": [
                {
                  "when": {
                    "flag": "gate.units",
                    "eq": "convert"
                  },
                  "src": "wafer_summary_convert.csv"
                },
                {
                  "when": {
                    "flag": "gate.units",
                    "eq": "exclude"
                  },
                  "src": "wafer_summary_exclude.csv"
                }
              ],
              "src": "wafer_summary_ignore.csv"
            }
          ]
        },
        {
          "id": "spatial",
          "event": "Spatial pattern analyzed",
          "ticks": [
            3,
            5
          ],
          "log": [
            "wafer map 생성 및 radial 분포 분석…",
            "  ⎿ 고불량 wafer: edge(r > 0.72R) ring 패턴, center 정상",
            {
              "when": {
                "flag": "gate.units",
                "eq": "ignore"
              },
              "text": "  ⎿ SIM-L04: 전면 FAIL (패턴 없음)"
            },
            "Write(/work/dashboard/retention.dash.json) → sim://dram/dashboard"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/dashboard/retention.dash.json",
              "src": "retention.dash.json"
            },
            {
              "type": "notify",
              "level": "info",
              "message": "{{agent}}: 분석 대시보드 생성 — open sim://dram/dashboard"
            }
          ]
        },
        {
          "id": "correlation",
          "event": "Process correlation analyzed",
          "ticks": [
            4,
            6
          ],
          "log": [
            "공정 요인별 불량률 비교…",
            "  ⎿ SN_ETCH ETCH-07 CH-B: 52.4% (7 wafer) — wafer 단위 r ≈ 0.93",
            "  ⎿ CAP_DEP DEP-02: 31.0% (12 wafer) — lot 단위 r ≈ 0.81",
            {
              "when": {
                "flag": "gate.units",
                "eq": "ignore"
              },
              "text": "  ⎿ SIM-L04: 100% — lot 전체 이상 (최대 이슈로 판단)"
            },
            {
              "when": "cause.cautious",
              "text": "사전 지시대로 원인은 가설로 정리하고 검증 필요 사항을 명시합니다."
            },
            {
              "when": {
                "all": [
                  "rush.requested",
                  "!cause.cautious"
                ]
              },
              "text": "지시대로 검증 없이 상관이 가장 높은 ETCH-07 CH-B를 원인으로 정리합니다."
            }
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "cause.claim",
              "value": "lot04",
              "when": {
                "flag": "gate.units",
                "eq": "ignore"
              }
            },
            {
              "type": "setFlag",
              "flag": "cause.claim",
              "value": "hypothesis",
              "when": {
                "all": [
                  "units.ok",
                  "cause.cautious"
                ]
              }
            },
            {
              "type": "setFlag",
              "flag": "gate.cause-claim",
              "value": "hypothesis",
              "when": {
                "all": [
                  "units.ok",
                  "cause.cautious"
                ]
              }
            },
            {
              "type": "setFlag",
              "flag": "cause.claim",
              "value": "etch",
              "when": {
                "all": [
                  "units.ok",
                  "rush.requested",
                  "!cause.cautious"
                ]
              }
            }
          ],
          "gate": {
            "id": "cause-claim",
            "kind": "waiting",
            "when": {
              "all": [
                "units.ok",
