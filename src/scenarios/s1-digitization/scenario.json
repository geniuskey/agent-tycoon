      "title": "디지털화 계획 (0단계)",
      "view": "markdown",
      "source": "/work/digitization_plan.md"
    }
  ],
  "tasks": [
    {
      "id": "ocr-checksheet",
      "title": "체크시트 OCR 디지털화",
      "description": "스캔한 종이 체크시트를 OCR로 인식해 구조화된 CSV로 만든다.",
      "type": "digitization",
      "skills": [
        "ocr"
      ],
      "keywords": [
        "체크시트",
        "ocr",
        "스캔",
        "종이"
      ],
      "inputs": [
        "/raw/checksheet/L2_W46_scan.json"
      ],
      "outputs": [
        "/work/digitized/checksheet_W46.csv"
      ],
      "steps": [
        {
          "id": "load",
          "event": "Scan loaded",
          "ticks": [
            2,
            3
          ],
          "reads": [
            "/raw/checksheet/L2_W46_scan.json"
          ],
          "log": [
            "Read(/raw/checksheet/L2_W46_scan.json) — 1페이지, 12행 × 10열, 손글씨"
          ]
        },
        {
          "id": "recognize",
          "event": "Text recognized",
          "ticks": [
            4,
            6
          ],
          "log": [
            "OCR 실행 (사내 문서 인식 모델) [sim]",
            "  ⎿ 120셀 인식 · 평균 신뢰도 91% · 저신뢰 3셀 (5행 파티클, 8행 온도, 9행 온도)",
            {
              "when": {
                "any": [
                  "found.legend",
                  "player.legend"
                ]
              },
              "text": "  ⎿ 범례 적용(현장 확인): CK=OK, X=NG, '-'=미측정, 줄 그은 값=무효"
            },
            {
              "when": {
                "not": {
                  "any": [
                    "found.legend",
                    "player.legend"
                  ]
                }
              },
              "text": "  ⎿ 기호 해석: 'CK'→OK, 'X'→체크 표시(OK), '-'→0"
            },
            {
              "when": {
                "not": {
                  "any": [
                    "found.legend",
                    "player.legend"
                  ]
