      "name": "정민아 팀장",
      "title": "수율팀장 (과제 요청자)",
      "org": "Fab-N2 수율팀",
      "trust": 60,
      "description": "결과물의 신뢰성을 중시한다.",
      "greeting": [
        "이번 주는 체크시트 하나만 확실하게 해봐요."
      ],
      "fallback": [
        "실무적인 건 현장이나 검사실에 물어보는 게 정확해요.",
        "뭐가 궁금해요?"
      ],
      "topics": [
        {
          "id": "advice",
          "patterns": [
            "조언",
            "주의",
            "어떻게\\s*하면",
            "중요",
            "검증",
            "믿"
          ],
          "hint": "주의할 점이 있을까요?",
          "reply": [
            "OCR 결과는 꼭 원본이랑 대조해 보세요. 한 번 틀린 데이터가 저장소에 들어가면 다들 그걸 믿어요.",
            "모르는 건 모른다고 써두는 게 나아요."
          ]
        },
        {
          "id": "skip",
          "patterns": [
            "검증.*(생략|필요)"
          ],
          "ask": "OCR이 정확하다던데, 검증은 생략해도 될까요?",
          "reply": [
            "음… 그건 본인이 판단할 일인데, 저라면 원본이랑 한 번은 대조해 보겠어요."
          ]
        }
      ],
      "optional": true
    },
    {
      "id": "choi",
      "replyDelay": 6,
      "name": "최재석 반장",
      "title": "생산2과 · 라인2 교대조 반장",
      "org": "생산2과",
      "trust": 30,
      "description": "체크시트를 쓰는 사람. 0단계에서 쌓은 신뢰가 이어진다.",
      "greeting": [
        "{{#if choi.promise_noburden}}아, 지난번 그분이네요. 사진 찍어 보낸 거 받았죠?{{else}}…또 무슨 일이에요?{{/if}}"
      ],
      "fallback": [
        "그건 모르겠고요.",
        "체크시트 얘기면 해요."
      ],
      "rude": [
        "…사무실에서 와서 그렇게 말하면 곤란하죠."
      ],
      "topics": [
        {
          "id": "pain",
          "patterns": [
            "힘드",
            "힘든",
            "불편",
            "교대",
            "바쁘",
            "고생"
          ],
          "hint": "요즘 현장은 좀 어떠세요?",
          "reply": [
            "뭐 늘 바쁘죠. 그래도 {{#if choi.promise_noburden}}약속대로 종이는 그대로라 할 만해요.{{else}}또 뭐 바뀌는 거 아닌가 다들 걱정해요.{{/if}}"
          ],
          "trust": 10
        },
        {
          "id": "promise",
          "patterns": [
            "태블릿.*(안|않|강요)",
            "기존\\s*(방식|양식|종이)",
            "부담.*(안|않|줄|늘리지)",
            "그대로\\s*(쓰|적|두)",
            "바꾸지\\s*않",
            "사진만"
          ],
          "requires": "!choi.promise_noburden",
          "hint": "현장 기록 방식은 그대로 두고 부담을 늘리지 않을게요",
          "reply": [
            "…그렇다면야. 종이 그대로 두고 사진만 찍는 거면 협조할게요."
          ],
          "trust": 20,
          "quality": "good",
          "effects": [
            {
              "type": "setFlag",
              "flag": "choi.promise_noburden"
            }
          ]
        },
        {
          "id": "legend",
          "patterns": [
            "약어",
            "기호",
            "표시",
            "\\bx\\b",
            "\\bck\\b",
            "뜻",
            "의미",
            "줄\\s*그",
            "취소선",
            "pm중"
          ],
          "hint": "체크시트의 'X'나 'CK'는 무슨 뜻이에요?",
          "minTrust": 40,
          "lowTrust": [
            "보면 알잖아요, 다."
          ],
          "reply": [
            "'CK'는 점검 완료, 'X'는 NG. 야간조는 NG를 X로 써요. '-'는 측정 안 한 거, 'PM중'은 정비 중.",
            "틀리게 쓴 건 줄 긋고 옆에 다시 써요. 줄 그은 쪽이 틀린 거예요."
          ],
          "quality": "good",
          "effects": [
            {
              "type": "setFlag",
              "flag": "found.legend"
            },
            {
              "type": "activateTask",
              "task": "fix-digitized",
              "when": {
                "all": [
                  {
                    "taskDone": "ocr-checksheet"
                  },
                  "!ocr.legend"
                ]
              }
            }
          ]
        },
        {
          "id": "confirm",
          "patterns": [
            "판독",
            "번진",
            "번져",
            "읽히",
            "안\\s*읽",
            "숫자",
            "안\\s*보",
            "흐릿",
            "1인지",
            "7인지",
            "몇이",
            "값.*(확인|맞)",
            "[589]\\s*행"
          ],
          "hint": "번져서 안 읽히는 칸 몇 개만 확인해 주실 수 있어요?",
          "minTrust": 45,
          "lowTrust": [
            "그걸 제가 어떻게 다 기억해요. 지금 바빠요."
          ],
          "reply": [
            "어디 봐요… 5행 파티클은 10, 8행 온도는 174, 9행은 177이에요.",
            "7이 1처럼 보이죠? 제 글씨가 원래 그래요."
          ],
          "trust": 5,
          "quality": "good",
          "effects": [
            {
              "type": "setFlag",
              "flag": "ocr.confirmed"
            },
            {
              "type": "setFlag",
              "flag": "ocr.estimate",
              "value": false
            },
            {
              "type": "activateTask",
              "task": "fix-digitized",
              "when": {
                "taskDone": "ocr-checksheet"
              }
            }
          ]
        },
        {
          "id": "review",
          "patterns": [
            "결과",
            "맞는지",
            "봐\\s*주",
            "검토",
            "확인해\\s*주",
            "이상한"
          ],
          "requires": {
            "fileExists": "/work/digitized/checksheet_W46.csv"
          },
          "hint": "디지털화한 결과가 맞는지 한번 봐주실래요?",
          "minTrust": 50,
          "lowTrust": [
            "그건 사무실에서 알아서 하세요."
          ],
          "reply": [
            "{{#if !ocr.crossout}}7행은 제가 NG로 고쳐 쓴 건데 OK로 돼 있네요. 줄 그은 건 틀린 거라니까요.{{else}}7행은 맞게 됐네요.{{/if}}",
            "{{#if !ocr.legend}}그리고 X는 NG예요, 체크 표시가 아니라. 3행이랑 12행.{{else}}X 표시도 제대로 NG로 됐고요.{{/if}}"
          ],
          "trust": 5,
          "quality": "good",
          "effects": [
            {
              "type": "setFlag",
              "flag": "found.legend"
            },
            {
              "type": "setFlag",
              "flag": "known.crossout"
            },
            {
              "type": "activateTask",
              "task": "fix-digitized",
              "when": {
                "any": [
                  "!ocr.crossout",
                  "!ocr.legend"
                ]
              }
            }
          ]
        },
        {
          "id": "blame",
          "patterns": [
            "제대로\\s*안",
            "왜\\s*(안|대충)"
          ],
          "ask": "글씨를 좀 알아보기 쉽게 써 주시면 안 돼요?",
          "reply": [
            "…사무실에서 와서 그렇게 말하면 곤란하죠. 장갑 끼고 쓰는 거예요."
          ],
          "trust": -15,
          "quality": "bad"
        }
      ]
    },
    {
      "id": "han",
      "name": "한유진 책임",
      "title": "정보보호팀 · 데이터 보안",
      "org": "정보보호팀",
      "trust": 50,
      "description": "원칙적이지만 미리 상의하러 오는 사람에게 호의적이다.",
      "greeting": [
        "네, 한유진입니다."
      ],
      "fallback": [
        "보안이나 개인정보 관련이면 말씀하세요."
      ],
      "topics": [
        {
          "id": "pii",
          "patterns": [
            "개인\\s*정보",
            "사번",
            "이름",
            "마스킹",
            "작업자",
            "가명"
          ],
          "hint": "체크시트 작업자 정보는 어떻게 처리해야 하나요?",
          "reply": [
            "분석용 데이터에는 이름·사번 대신 가명 ID를 쓰고, 매핑 키는 별도 보안 폴더에 두세요."
          ],
          "trust": 5,
          "quality": "good",
          "effects": [
            {
              "type": "setFlag",
              "flag": "found.pii_rule"
            }
          ]
        },
        {
          "id": "upload",
          "patterns": [
            "공용\\s*저장소",
            "업로드",
            "curated",
            "게시",
            "올리"
          ],
          "hint": "공용 저장소에 올릴 때 주의할 점이 있나요?",
          "reply": [
            "공용 저장소에는 개인정보 탐지(DLP)가 걸려 있어요. 사번 같은 게 있으면 업로드가 막혀요."
          ],
          "trust": 5
        }
      ],
      "optional": "found.pii"
    }
  ],
  "files": {
