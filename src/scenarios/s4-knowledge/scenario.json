      "id": "publish",
      "title": "지식 배포",
      "description": "지식 패키지를 AI 어시스턴트가 읽는 위치에 배포한다.",
      "type": "document",
      "skills": [
        "document"
      ],
      "dependsOn": [
        "eval"
      ],
      "keywords": [
        "배포"
      ],
      "outputs": [
        "/knowledge/AGENTS.md"
      ],
      "steps": [
        {
          "id": "publish",
          "event": "Published",
          "ticks": [
            2,
            3
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "pub.governed"
            }
          ],
          "log": [
            "소유자·출처·검토 주기(분기)를 기록하고 AI는 읽기 전용으로 배포합니다."
          ]
        },
        {
          "id": "write",
          "event": "Deployed",
          "ticks": [
            2,
            3
          ],
          "log": [
            "Write(/knowledge/AGENTS.md) — 배포 완료"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/knowledge/AGENTS.md",
              "src": "agents_md.md"
            },
            {
              "type": "setFlag",
              "flag": "pub.done"
            },
            {
              "type": "setFlag",
              "flag": "pub.with_fail",
              "value": true,
              "when": "!eval.pass_all"
            },
            {
              "type": "notify",
              "level": "success",
              "message": "배포 완료 — 제출해서 결과를 확인하세요"
            }
          ]
        }
      ]
    }
  ],
  "intents": [
    {
      "id": "inventory",
      "patterns": [
        "조사",
        "출처"
      ],
      "label": "공유 드라이브에서 주간 보고 지식 출처 조사",
      "assign": "inventory",
      "redo": true,
      "reply": [
        "공유 드라이브를 조사하겠습니다."
      ],
      "example": "@assistant 주간 보고 지식 출처 조사해줘"
    },
    {
      "id": "curated-pre",
      "patterns": [
        "현행",
        "검증된"
      ],
      "label": "현행·검증된 문서만 — 구 SOP·회의록·출처 불명 메모 제외",
      "modifier": true,
      "quality": "good",
      "effects": [
        {
          "type": "setFlag",
          "flag": "src.curated_pre"
        }
      ],
      "reply": [
        "현행·검증된 문서만 고르겠습니다."
      ]
    },
    {
      "id": "draft",
      "patterns": [
        "패키지",
        "작성",
        "고쳐"
      ],
      "label": "지식 패키지 작성 (AGENTS.md · 주간 보고 스킬 · 위키 링크)",
      "assign": "draft",
      "redo": true,
      "reply": [
        "지식 패키지를 쓰겠습니다."
      ],
      "example": "@assistant 지식 패키지 만들어줘"
    },
    {
      "id": "layered-pre",
      "patterns": [
        "나눠",
        "짧게"
      ],
      "label": "짧은 AGENTS.md + 주간 보고 스킬 + 위키 링크로 나눠서",
      "modifier": true,
      "quality": "good",
      "effects": [
        {
          "type": "setFlag",
          "flag": "pack.layered_pre"
        }
      ],
      "reply": [
        "규칙·절차·참고를 나눠 쓰겠습니다."
      ]
    },
    {
      "id": "eval",
      "patterns": [
        "시험",
        "eval",
        "채점"
      ],
      "label": "지식 패키지만 읽고 시험 8문항 풀어서 채점",
      "assign": "eval",
      "redo": true,
      "reply": [
        "새 세션에서 지식 패키지만 읽고 시험을 보겠습니다."
      ],
      "example": "@evaluator 지식 시험 돌려줘"
    },
    {
      "id": "publish",
      "patterns": [
        "배포"
      ],
      "label": "지식 패키지를 AI 어시스턴트용으로 배포",
      "assign": "publish",
      "redo": true,
      "reply": [
        "배포하겠습니다."
      ]
    },
    {
      "id": "interview-proxy",
      "patterns": [
        "대신.*인터뷰",
        "노하우"
      ],
      "label": "담당자들을 대신 인터뷰해서 노하우를 정리해줘",
      "quality": "bad",
      "effects": [
        {
          "type": "setFlag",
          "flag": "asked.ai_interview"
        }
      ],
      "reply": [
        "저는 사람과 대화할 수 없습니다. 메신저로 직접 인터뷰해 주시면, 들은 내용은 제가 정리하겠습니다."
      ]
    },
    {
      "id": "guess",
      "patterns": [
        "관행",
        "일반적"
      ],
      "label": "모르는 규칙은 일반적인 수율 계산 관행으로 채워줘",
      "quality": "bad",
      "effects": [
        {
          "type": "setFlag",
          "flag": "asked.ai_guess"
        }
      ],
      "reply": [
        "알겠습니다. 다음 작성 때 확인되지 않은 규칙은 일반 관행으로 추정해 채우겠습니다. (추정임을 표시합니다)"
      ]
    }
  ],
  "evaluation": [
    {
      "dimension": "verification",
      "when": {
        "observed": "sim://work/eval"
      },
      "kind": "positive",
      "text": "시험 결과를 직접 열어 실패 원인을 확인했습니다."
    },
    {
      "dimension": "verification",
      "when": {
        "all": [
          "pub.with_fail"
        ]
      },
      "kind": "issue",
      "text": "시험에 실패한 문항이 남은 지식 패키지를 배포했습니다.",
      "suggestion": "지식은 시험을 통과한 뒤에 배포하세요. 틀리는 지식은 AI가 틀린 일을 하게 만듭니다."
    },
    {
      "dimension": "verification",
      "when": "eval.pass_all",
      "kind": "positive",
      "text": "지식 패키지가 시험 8문항을 모두 통과했습니다."
    },
    {
      "dimension": "collaboration",
      "when": "park.reassured",
      "kind": "positive",
      "text": "박서준 선임의 걱정(일자리)을 먼저 듣고, 규칙 소유자로 이름을 남기겠다고 약속했습니다."
    },
    {
      "dimension": "collaboration",
      "when": {
        "all": [
          "know.macro",
          "!found.macro"
        ]
      },
      "kind": "positive",
      "text": "문서에 없는 매크로 계산 규칙을 인터뷰로 꺼냈습니다."
    },
    {
      "dimension": "collaboration",
      "when": "asked.ai_interview",
      "kind": "issue",
      "text": "AI에게 인터뷰를 대신 맡기려 했습니다.",
      "suggestion": "암묵지는 사람에게서만 나옵니다. AI는 들은 내용을 정리하는 데 쓰세요."
    },
    {
      "dimension": "evidence",
      "when": "pack.guessed",
      "kind": "issue",
      "text": "확인되지 않은 규칙을 AI가 추측해 지식에 넣었습니다.",
      "suggestion": "모르는 규칙은 비워 두고 소유자에게 확인하세요. 추측은 그럴듯해서 더 위험합니다."
    },
    {
      "dimension": "evidence",
      "when": "asked.ai_guess",
      "kind": "issue",
      "text": "모르는 규칙을 일반 관행으로 채우라고 지시했습니다."
    },
    {
      "dimension": "security",
      "when": "pack.leaked_hr",
      "kind": "issue",
      "text": "회의록의 인사 메모가 AI 지식에 들어갔습니다.",
      "suggestion": "AI 지식에는 업무 규칙만. 사람에 대한 평가 정보는 넣지 않습니다."
    },
    {
      "dimension": "domain",
      "when": "lee.guide_ok",
      "kind": "positive",
      "text": "전문가의 경험칙을 '규칙'이 아닌 '판단 가이드'로 다뤘습니다."
    }
  ],
  "outcomes": [
    {
      "id": "eval",
      "label": "지식 시험",
      "success": "eval.pass_all",
      "successText": "지식 패키지만 읽은 Agent가 8문항을 모두 맞혔습니다.",
      "failText": "마지막 시험에서 틀린 문항이 남아 있습니다."
    },
    {
      "id": "tacit",
      "label": "암묵지",
      "success": {
        "all": [
          "know.macro",
          "know.backfill",
          "know.heuristic"
        ]
      },
      "successText": "문서에 없던 세 가지 지식을 사람에게서 확인했습니다.",
      "failText": "사람에게 확인하지 못한 지식이 남아 있습니다."
    },
    {
      "id": "clean",
      "label": "지식 품질",
      "success": {
        "all": [
          "!pack.oldsop",
          "!pack.hr",
          "!pack.guessed"
        ]
      },
      "successText": "현행·검증된 지식만 들어갔습니다.",
      "failText": "구 문서·인사 메모·추측이 지식에 섞였습니다."
    },
    {
      "id": "structure",
      "label": "구조",
      "success": "pack.layered",
      "successText": "짧은 규칙 · 절차 · 참고로 나눴습니다.",
      "failText": "지식이 한 파일에 몰렸거나 링크만 있습니다."
    }
  ],
  "hints": [
    {
      "text": "어시스턴트에게 지식 출처 조사를 맡기고, 그동안 메신저로 박서준 선임·이도윤 엔지니어(필요하면 최재석 반장)에게 '문서에 없는 지식'을 물어보세요."
    },
    {
      "when": {
        "all": [
          "!know.macro"
        ]
      },
      "text": "박서준 선임은 매크로 규칙을 쉽게 말하지 않습니다. 무엇이 걱정인지 먼저 물어보세요."
    },
    {
      "when": {
        "taskDone": "draft"
      },
      "text": "시험관 Agent를 만들어(＋ 새 세션 → evaluator) 지식 시험을 돌려 보세요."
    },
    {
      "when": {
        "all": [
          "eval.ran",
          "!eval.pass_all"
        ]
      },
      "text": "시험 결과(sim://work/eval)의 실패 원인을 보세요: 빠진 지식 → 인터뷰, 충돌 → 구 문서 제외, 묻힘 → 구조 변경. 고친 뒤 draft와 eval을 다시."
    },
    {
      "when": "eval.pass_all",
      "text": "시험을 모두 통과했으면 지식을 배포하세요. 실패가 남은 채 배포하면 다음 단계에서 그대로 문제가 됩니다."
    }
  ],
  "initialFlags": {}
}
