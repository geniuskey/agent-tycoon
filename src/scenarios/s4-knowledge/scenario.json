          "effects": [
            {
              "type": "setFlag",
              "flag": "know.macro",
              "value": true,
              "when": "found.macro"
            },
            {
              "type": "setFlag",
              "flag": "know.backfill",
              "value": true,
              "when": "found.backfill"
            },
            {
              "type": "setFlag",
              "flag": "src.curated",
              "value": true,
              "when": "src.curated_pre"
