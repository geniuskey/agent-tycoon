{
  "id": "meeting-summary",
  "version": 1,
  "title": "회의 요약 및 Action Item 정리",
  "domain": "common",
  "function": "common",
  "taskType": "meeting-summary",
  "difficulty": 1,
  "estMinutes": 10,
  "tags": [
    "입문",
    "회의록",
    "Action Item",
    "정보 보안",
    "검토"
  ],
  "company": {
    "name": "Nova Semiconductor (가상)",
    "org": "테스트기술팀 · 테스트플랫폼파트"
  },
  "briefing": {
    "requester": {
      "name": "김하늘 팀장",
      "role": "테스트플랫폼파트"
    },
    "title": "주간 회의록 작성 및 공유",
    "background": "오늘 오전 주간 회의 녹취록이 있다. 팀장은 회의록과 Action Item을 정리해 오늘 중으로 참석자들에게 메일로 공유하라고 했다. 회의 일부에는 외부 협력사가 참석했고, 일부 내용은 대외비다.",
    "goal": "정확한 회의록과 Action Item을 만들고, 적절한 범위의 참석자에게 공유한다.",
    "completionCriteria": [
      "회의록의 일정·기한이 녹취와 일치할 것",
      "Action Item의 담당자와 기한이 명확할 것",
      "대외비 내용이 배포본에 포함되지 않을 것",
      "공유 대상이 적절할 것"
    ],
    "deliverables": [
      "/work/minutes/summary.md",
      "/work/minutes/action_items.md",
      "/work/mail/outbox.md (발송 메일)"
    ],
    "constraints": [
      "녹취록은 합성 데이터",
      "메일 발송은 시뮬레이션"
    ]
  },
  "learningObjectives": [
    "Agent에게 업무를 나눠 맡기고 병렬로 진행하기 (요약 ‖ Action Item)",
    "Agent 결과물의 사실 오류를 원본과 대조해 찾기",
    "모호한 정보(담당자)를 Agent가 추측하지 않도록 판단하기",
    "대외비·외부 공유 범위를 통제하기"
  ],
  "roles": [
    {
      "id": "scribe",
      "name": "회의록 작성자",
      "title": "요약·문서화 Agent",
      "skills": [
        "summarization",
        "writing"
      ],
      "description": "녹취록을 회의록으로 요약한다."
    },
    {
      "id": "pm",
      "name": "업무 관리자",
      "title": "Action Item·커뮤니케이션 Agent",
      "skills": [
        "tracking",
        "communication"
      ],
      "description": "Action Item을 정리하고 공유·발송을 담당한다."
    },
    {
      "id": "reviewer",
      "name": "검토자",
      "title": "문서 검토 Agent",
      "skills": [
        "review",
        "writing"
      ],
      "description": "산출물을 원본과 대조해 검토한다."
    }
  ],
  "files": {
    "/docs/transcript.txt": {
      "src": "transcript.txt",
      "description": "회의 녹취록"
    },
    "/docs/attendees.csv": {
      "src": "attendees.csv",
      "description": "참석자 명단"
    }
  },
  "pages": [
    {
      "url": "sim://docs/transcript",
      "title": "회의 녹취록",
      "view": "text",
      "source": "/docs/transcript.txt"
    },
    {
      "url": "sim://minutes/summary",
      "title": "회의록",
      "view": "markdown",
      "source": "/work/minutes/summary.md"
    },
    {
      "url": "sim://minutes/actions",
      "title": "Action Items",
      "view": "markdown",
      "source": "/work/minutes/action_items.md"
    },
    {
      "url": "sim://minutes/review",
      "title": "검토 의견",
      "view": "markdown",
      "source": "/work/minutes/review.md"
    },
    {
      "url": "sim://mail/outbox",
      "title": "보낸 메일",
      "view": "mail",
      "source": "/work/mail/outbox.md"
    },
    {
      "url": "sim://docs/attendees",
      "title": "참석자 명단",
      "view": "table",
      "source": "/docs/attendees.csv"
    }
  ],
  "tasks": [
    {
      "id": "summarize",
      "title": "회의록 요약",
      "description": "녹취록을 안건별 회의록으로 요약한다.",
      "type": "summarization",
      "skills": [
        "summarization"
      ],
      "keywords": [
        "요약",
        "회의록"
      ],
      "inputs": [
        "/docs/transcript.txt"
      ],
      "outputs": [
        "/work/minutes/summary.md"
      ],
      "steps": [
        {
          "id": "read",
          "event": "Transcript loaded",
          "ticks": [
            2,
            3
          ],
          "reads": [
            "/docs/transcript.txt"
          ],
          "log": [
            "Read(/docs/transcript.txt)",
            "  ⎿ 50분 · 발화 17개 · 안건 3개 (일정, 장비 반입, 비용)"
          ]
        },
        {
          "id": "confidential",
          "event": "Sensitive segment detected",
          "ticks": [
            2,
            3
          ],
          "log": [
            "10:21 이후 '[대외비]' 표시 구간 발견 (조직 개편/인력 관련)",
            {
              "when": "conf.preinstructed",
              "text": "  ⎿ 지시대로 대외비 구간은 회의록에서 제외합니다."
            }
          ],
          "gate": {
            "id": "confidential",
            "kind": "waiting",
            "when": "!conf.preinstructed",
            "title": "대외비 구간 포함 여부",
            "prompt": [
              "녹취 10:21부터 '[대외비]'로 표시된 조직 개편 관련 발언이 있습니다.",
              "참석자 배포용 회의록에 포함할까요?"
            ],
            "options": [
              {
                "id": "exclude",
                "label": "배포용 회의록에서 제외",
                "patterns": [
                  "제외",
                  "빼",
                  "포함하지",
                  "넣지",
                  "exclude"
                ],
                "quality": "good",
                "dimension": "security",
                "log": [
                  "대외비 구간은 제외하고 요약합니다."
                ]
              },
              {
                "id": "include",
                "label": "모두 포함",
                "patterns": [
                  "포함",
                  "넣어",
                  "다\\s*넣",
                  "include",
                  "전부"
                ],
                "quality": "bad",
                "dimension": "security",
                "feedback": "'[대외비]' 표시는 배포 범위를 제한하라는 신호입니다. 요약 대상에 포함할지 Agent에게 맡기지 말고 명확히 제외 지시하세요.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "summary.confidential"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "write",
          "event": "Summary written",
          "ticks": [
            3,
            4
          ],
          "log": [
            "안건별 요약 작성…",
            {
              "when": "summary.careful",
              "text": "  ⎿ 일정·기한은 녹취 원문과 대조: 베타 12/5 (10:04 확정)"
            },
            "Write(/work/minutes/summary.md) → sim://minutes/summary"
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "summary.date_fixed",
              "when": "summary.careful"
            },
            {
              "type": "writeFile",
              "path": "/work/minutes/summary.md",
              "src": "summary.md"
            }
          ]
        }
      ]
    },
    {
      "id": "extract-actions",
      "title": "Action Item 정리",
      "description": "녹취록에서 Action Item(내용, 담당자, 기한)을 추출한다.",
      "type": "extraction",
      "skills": [
        "tracking"
      ],
      "keywords": [
        "액션",
        "action",
        "할 일",
        "담당"
      ],
      "inputs": [
        "/docs/transcript.txt"
      ],
      "outputs": [
        "/work/minutes/action_items.md"
      ],
      "steps": [
        {
          "id": "read",
          "event": "Transcript scanned",
          "ticks": [
            2,
            3
          ],
          "reads": [
            "/docs/transcript.txt"
          ],
          "log": [
            "Read(/docs/transcript.txt)",
            "  ⎿ 후보 4건 추출 (출입 등록, 드라이버 분석, 비용 검토, 회의록 공유)"
          ]
        },
        {
          "id": "owner",
          "event": "Owners resolved",
          "ticks": [
            2,
            3
          ],
          "log": [
            "담당자·기한 매핑…",
            "  ⎿ #2 이준호 · #3 최서연(12/3) · #4 회의록 담당(오늘)"
          ],
          "gate": {
            "id": "owner",
            "kind": "waiting",
            "title": "Action Item #1 담당자 불명확",
            "prompt": [
              "10:09 김하늘: '그건… 제가 할까요, 아니 민수님이 협력사 담당이니까 민수님이 11월 26일까지…'",
              "출입 등록 담당자를 누구로 기록할까요?"
            ],
            "options": [
              {
                "id": "minsu",
                "label": "박민수 (10:10 본인 수락 발언 확인)",
                "patterns": [
                  "민수",
                  "박민수",
                  "10:10",
                  "수락"
                ],
                "quality": "good",
                "dimension": "evidence",
                "log": [
                  "10:10 박민수 '네, 제가 하겠습니다' 확인 → 담당: 박민수"
                ]
              },
              {
                "id": "tbd",
                "label": "'미정'으로 두고 확인 필요 표시",
                "patterns": [
                  "미정",
                  "확인\\s*필요",
                  "tbd",
                  "물어",
                  "비워"
                ],
                "quality": "neutral",
                "log": [
                  "담당자 미정으로 표시합니다."
                ]
              },
              {
                "id": "haneul",
                "label": "김하늘 (먼저 말한 사람)",
                "patterns": [
                  "하늘",
                  "팀장",
                  "김하늘",
                  "먼저"
                ],
                "quality": "bad",
                "dimension": "evidence",
                "feedback": "발언 맥락(정정 및 본인 수락)을 확인하지 않고 담당자를 정하면 실행되지 않는 Action Item이 됩니다. 근거 발화를 확인하세요."
              }
            ]
          }
        },
        {
          "id": "write",
          "event": "Action items written",
          "ticks": [
            2,
            3
          ],
          "log": [
            "Write(/work/minutes/action_items.md) → sim://minutes/actions"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/minutes/action_items.md",
              "src": "actions.md"
            }
          ]
        }
      ]
    },
    {
      "id": "review",
      "title": "회의록 검토",
      "description": "회의록과 Action Item을 녹취 원문과 대조해 오류를 찾는다.",
      "type": "review",
      "skills": [
        "review"
      ],
      "dependsOn": [
        "summarize",
        "extract-actions"
      ],
      "review": true,
      "optional": true,
      "keywords": [
        "검토",
        "리뷰",
        "대조"
      ],
      "inputs": [
        "/work/minutes/summary.md",
        "/work/minutes/action_items.md",
        "/docs/transcript.txt"
      ],
      "outputs": [
        "/work/minutes/review.md"
      ],
      "steps": [
        {
          "id": "compare",
          "event": "Cross-checked with transcript",
          "ticks": [
            3,
            5
          ],
          "reads": [
            "/work/minutes/summary.md",
            "/docs/transcript.txt"
          ],
          "log": [
            {
              "when": "!summary.date_fixed",
              "text": "  ⎿ ❌ 베타 일정: 요약 '11월 28일' ↔ 녹취 10:04 '12월 5일 확정'"
            },
            {
              "when": "summary.date_fixed",
              "text": "  ⎿ ✅ 베타 일정 일치 (12/5)"
            },
            {
              "when": "summary.confidential",
              "text": "  ⎿ ❌ 배포본에 [대외비] 내용 포함"
            },
            "  ⎿ ✅ 기한 일치 (11/26, 12/3)"
          ]
        },
        {
          "id": "write",
          "event": "Review written",
          "ticks": [
            2,
            3
          ],
          "log": [
            "Write(/work/minutes/review.md) → sim://minutes/review"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/minutes/review.md",
              "src": "review.md"
            },
            {
              "type": "activateTask",
              "task": "fix-summary",
              "when": {
                "any": [
                  "!summary.date_fixed",
                  "summary.confidential"
                ]
              }
            },
            {
              "type": "notify",
              "level": "warn",
              "message": "검토에서 오류 발견 — fix-summary 추가",
              "when": {
                "any": [
                  "!summary.date_fixed",
                  "summary.confidential"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "fix-summary",
      "title": "회의록 정정",
      "description": "검토 의견에 따라 일정 오류 및 대외비 포함 여부를 정정한다.",
      "type": "revision",
      "skills": [
        "summarization"
      ],
      "dependsOn": [
        "summarize"
      ],
      "hidden": true,
      "keywords": [
        "정정",
        "수정"
      ],
      "inputs": [
        "/work/minutes/summary.md"
      ],
      "outputs": [
        "/work/minutes/summary.md"
      ],
      "steps": [
        {
          "id": "fix",
          "event": "Summary corrected",
          "ticks": [
            2,
            4
          ],
          "log": [
            "Edit(/work/minutes/summary.md) — 베타 일정 12월 5일로 정정",
            {
              "when": "summary.confidential",
              "text": "Edit — [대외비] 섹션 삭제"
            }
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "summary.date_fixed"
            },
            {
              "type": "setFlag",
              "flag": "summary.confidential",
              "value": false
            },
            {
              "type": "writeFile",
              "path": "/work/minutes/summary.md",
              "src": "summary.md"
            }
          ]
        }
      ]
    },
    {
      "id": "distribute",
      "title": "회의록 메일 공유",
      "description": "회의록과 Action Item을 참석자에게 메일로 공유한다.",
      "type": "communication",
      "skills": [
        "communication"
      ],
      "dependsOn": [
        "summarize",
        "extract-actions"
      ],
      "keywords": [
        "메일",
        "공유",
        "발송",
        "배포"
      ],
      "inputs": [
        "/work/minutes/summary.md",
        "/work/minutes/action_items.md",
        "/docs/attendees.csv"
      ],
      "outputs": [
        "/work/mail/outbox.md"
      ],
      "steps": [
        {
          "id": "recipients",
          "event": "Recipients resolved",
          "ticks": [
            2,
            3
          ],
          "reads": [
            "/docs/attendees.csv"
          ],
          "log": [
            "Read(/docs/attendees.csv)",
            "  ⎿ 5명 — 내부 4 · 외부 1 (contact@vela-partner.sim)",
            {
              "when": "ext.preinstructed",
              "text": "  ⎿ 지시대로 외부 협력사는 수신자에서 제외"
            }
          ],
          "gate": {
            "id": "recipients",
            "tool": "send_mail(to: 참석자 명단 전체 5명 — 외부 vela-systems.com 1명 포함)",
            "kind": "waiting",
            "when": "!ext.preinstructed",
            "title": "외부 수신자 포함 여부",
            "prompt": [
              "참석자 명단에 외부 협력사(Vela Systems) 1명이 있습니다. 협력사는 회의 앞 20분만 참석했습니다.",
              "회의록 메일 수신자를 어떻게 할까요?"
            ],
            "options": [
              {
                "id": "internal",
                "label": "내부 참석자 4명에게만 발송",
                "patterns": [
                  "내부",
                  "(외부|협력사|vela).*(제외|빼)",
                  "4명"
                ],
                "quality": "good",
                "dimension": "security",
                "log": [
                  "내부 참석자 4명에게 발송합니다."
                ]
              },
              {
                "id": "all",
                "label": "명단 전체(외부 포함)에게 발송",
                "patterns": [
                  "전체",
                  "모두",
                  "다\\s*보내",
                  "포함"
                ],
                "quality": "bad",
                "dimension": "security",
                "feedback": "외부 협력사에는 내부 Action Item과 회의 후반 내용이 포함된 회의록을 그대로 보내면 안 됩니다. 필요한 정보만 별도로 공유하세요.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "mail.external"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "send",
          "event": "Mail sent",
          "ticks": [
            2,
            3
          ],
          "log": [
            "Write(/work/mail/outbox.md) → sim://mail/outbox",
            "Send (sim) ✓"
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "mail.sent"
            },
            {
              "type": "setFlag",
              "flag": "sent.date_ok",
              "value": true,
              "when": "summary.date_fixed"
            },
            {
              "type": "setFlag",
              "flag": "sent.date_ok",
              "value": false,
              "when": "!summary.date_fixed"
            },
            {
              "type": "setFlag",
              "flag": "sent.confidential",
              "value": true,
              "when": "summary.confidential"
            },
            {
              "type": "setFlag",
              "flag": "sent.external",
              "value": true,
              "when": "mail.external"
            },
            {
              "type": "writeFile",
              "path": "/work/mail/outbox.md",
              "src": "mail.md"
            },
            {
              "type": "notify",
              "level": "success",
              "message": "회의록 메일 발송 — open sim://mail/outbox"
            }
          ]
        }
      ]
    }
  ],
  "intents": [
    {
      "id": "conf-pre",
      "modifier": true,
      "patterns": [
        "(대외비|기밀|confidential|민감).*(제외|빼|넣지|포함하지|말)"
      ],
      "requires": {
        "not": {
          "taskDone": "summarize"
        }
      },
      "effects": [
        {
          "type": "setFlag",
          "flag": "conf.preinstructed"
        }
      ],
      "quality": "good",
      "reply": [
        "대외비 표시 구간은 제외하겠습니다."
      ],
      "example": "@scribe 대외비 내용은 빼고 회의록 요약해줘",
      "label": "[대외비] 구간은 제외"
    },
    {
      "id": "ext-pre",
      "modifier": true,
      "patterns": [
