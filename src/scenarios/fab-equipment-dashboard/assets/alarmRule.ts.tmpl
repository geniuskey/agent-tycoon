export type Limits = { ucl: number; lcl?: number };

{{#if rule=spc}}// 설비별 SPC 관리한계 (평균 ± 3σ, 정상 구간 00:00–12:00 기준)
export const LIMITS: Record<string, Limits> = {
  'ETCH-03': { ucl: 45.1, lcl: 38.5 },
  'ETCH-07': { ucl: 42.7, lcl: 37.2 },
  'DEP-02': { ucl: 57.8, lcl: 52.2 },
  'CMP-01': { ucl: 32.6, lcl: 27.5 },
};{{else}}// 고정 임계값 (요구사항서 예시값)
const THRESHOLD = 50;
export const LIMITS: Record<string, Limits> = {
  'ETCH-03': { ucl: THRESHOLD },
  'ETCH-07': { ucl: THRESHOLD },
  'DEP-02': { ucl: THRESHOLD },
  'CMP-01': { ucl: THRESHOLD },
};{{/if}}

export function isAlarm(tool: string, value: number): boolean {
  const l = LIMITS[tool];
  if (!l) return false;
  return value > l.ucl || (l.lcl !== undefined && value < l.lcl);
}
