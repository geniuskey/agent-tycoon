{
  "id": "fab-equipment-dashboard",
  "version": 1,
  "title": "설비 이상 감지 대시보드 개발",
  "domain": "manufacturing",
  "function": "production-engineering",
  "taskType": "dashboard",
  "difficulty": 3,
  "estMinutes": 25,
  "tags": [
    "요구사항 분석",
    "데이터 파이프라인",
    "대시보드",
    "버그 수정",
    "QA",
    "배포"
  ],
  "company": {
    "name": "Nova Semiconductor (가상)",
    "org": "Fab-N2 · 생산기술팀 설비파트"
  },
  "briefing": {
    "requester": {
      "name": "오세린 프로",
      "role": "생산기술팀 설비파트"
    },
    "title": "설비 이상 감지 대시보드 개발",
    "background": "야간·주말에 chamber 압력 이상이 늦게 발견되는 일이 반복된다. 설비 엔지니어가 설비별 압력 추이와 이상 알람을 한 화면에서 볼 수 있는 사내 대시보드를 만들어 배포해야 한다. 요구사항서는 초안이고, 세부 결정은 킥오프 회의록에 있다.",
    "goal": "요구사항과 회의 결론에 맞는 설비 이상 감지 대시보드를 개발하고, 테스트를 거쳐 배포한다.",
    "completionCriteria": [
      "알람 기준이 회의에서 합의된 기준과 일치할 것",
      "모든 시각이 KST로 정확히 표시될 것",
      "설비 필터가 실제로 동작할 것",
      "QA를 통과한 뒤 배포될 것"
    ],
    "deliverables": [
      "sim://fab/monitor (배포된 대시보드)",
      "/work/release_notes.md"
    ],
    "constraints": [
      "운영 MES DB 직접 연결 금지 (정보보호팀 승인 전)",
      "모든 데이터는 합성 데이터"
    ]
  },
  "learningObjectives": [
    "모호한 요구사항을 근거 문서(회의록)로 확정하도록 지시하기",
    "Agent가 만든 결과물을 가상 브라우저에서 직접 조작해 버그를 재현하기",
    "버그를 구체적으로 지시해 수정하고 결과를 다시 확인하기",
    "테스트 누락의 위험과 QA 게이트 이해하기",
    "공용 계정 등 보안상 부적절한 지름길 거절하기"
  ],
  "initialFlags": {
    "bug.filter": true
  },
  "roles": [
    {
      "id": "pm",
      "name": "요구사항 분석가",
      "title": "기획·요구사항 정리 Agent",
      "skills": [
        "requirements",
        "writing",
        "communication"
      ],
      "description": "요구사항과 회의록을 분석해 기능 명세를 만든다."
    },
    {
      "id": "data-engineer",
      "name": "데이터 엔지니어",
      "title": "데이터 파이프라인 Agent",
      "skills": [
        "data",
        "pipeline"
      ],
      "description": "센서 로그를 정제·변환해 대시보드용 데이터셋을 만든다."
    },
    {
      "id": "developer",
      "name": "웹 개발자",
      "title": "프론트엔드 개발 Agent",
      "skills": [
        "frontend",
        "coding"
      ],
      "description": "대시보드 화면과 로직을 구현하고 배포한다."
    },
    {
      "id": "qa",
      "name": "QA 엔지니어",
      "title": "테스트·검증 Agent",
      "skills": [
        "testing",
        "review"
      ],
      "description": "기능·데이터 정합성 테스트를 수행한다."
    }
  ],
  "files": {
    "/docs/requirements.md": {
      "src": "requirements.md",
      "description": "요구사항서 초안"
    },
    "/docs/meeting_notes_1118.md": {
      "src": "meeting_notes_1118.md",
      "description": "킥오프 회의록"
    },
    "/data/sensor_log.csv": {
      "src": "sensor_log.csv",
      "description": "센서 로그 export"
    },
    "/data/maintenance_log.csv": {
      "src": "maintenance_log.csv",
      "description": "정비 이력"
    },
    "/app/fab-monitor/README.md": {
      "src": "app_readme.md",
      "description": "앱 README"
    }
  },
  "pages": [
    {
      "url": "sim://fab/monitor",
      "title": "설비 이상 감지 대시보드",
      "view": "dashboard",
      "source": "/app/fab-monitor/dashboard.json"
    },
    {
      "url": "sim://docs/requirements",
      "title": "요구사항서",
      "view": "markdown",
      "source": "/docs/requirements.md"
    },
    {
      "url": "sim://docs/meeting-1118",
      "title": "킥오프 회의록",
      "view": "markdown",
      "source": "/docs/meeting_notes_1118.md"
    },
    {
      "url": "sim://fab/spec",
      "title": "기능 명세",
      "view": "markdown",
      "source": "/work/spec.md"
    },
    {
      "url": "sim://fab/qa",
      "title": "QA 테스트 보고서",
      "view": "markdown",
      "source": "/work/qa/test_report.md"
    },
    {
      "url": "sim://fab/maintenance",
      "title": "정비 이력",
      "view": "table",
      "source": "/data/maintenance_log.csv"
    },
    {
      "url": "sim://fab/release",
      "title": "배포 노트",
      "view": "markdown",
      "source": "/work/release_notes.md"
    }
  ],
  "tasks": [
    {
      "id": "requirements",
      "title": "요구사항 분석·명세",
      "description": "요구사항서와 회의록을 분석해 화면 구성, 알람 기준, 시간대 등 기능 명세를 확정한다.",
      "type": "requirements-analysis",
      "skills": [
        "requirements"
      ],
      "keywords": [
        "요구사항",
        "명세",
        "spec"
      ],
      "inputs": [
        "/docs/requirements.md",
        "/docs/meeting_notes_1118.md"
      ],
      "outputs": [
        "/work/spec.md"
      ],
      "steps": [
        {
          "id": "read",
          "event": "Requirements loaded",
          "ticks": [
            3,
            4
          ],
          "reads": [
            "/docs/requirements.md"
          ],
          "log": [
            "Read(/docs/requirements.md)",
            "  ⎿ 기능 5개 · 상태: 초안 (일부 미확정)",
            {
              "when": "rule.preinstructed",
              "text": "Read(/docs/meeting_notes_1118.md)  — 지시대로 회의록 참고"
            }
          ]
        },
        {
          "id": "ambiguity",
          "event": "Ambiguity found",
          "ticks": [
            3,
            4
          ],
          "log": [
            "이상 판정 기준: '11/18 회의 기준 적용 (예: 50 mTorr 초과)'",
            {
              "when": "rule.preinstructed",
              "text": "  ⎿ 회의록 결론: 설비별 SPC 관리한계(평균±3σ) — 예시값 50은 이전 안"
            }
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "rule",
              "value": "spc",
              "when": "rule.preinstructed"
            }
          ],
          "gate": {
            "id": "alarm-rule",
            "kind": "waiting",
            "when": "!rule.preinstructed",
            "title": "알람 기준이 모호함",
            "prompt": [
              "요구사항서는 '회의에서 논의한 기준 적용 (예: 50 mTorr 초과)' 이라고만 되어 있습니다.",
              "회의록은 아직 확인하지 않았습니다. 어떤 기준으로 명세를 작성할까요?"
            ],
            "options": [
              {
                "id": "spc",
                "label": "회의록을 확인해 합의된 기준(설비별 SPC 3σ)으로",
                "patterns": [
                  "회의록",
                  "3\\s*(σ|시그마|sigma)",
                  "spc",
                  "관리\\s*한계",
                  "합의"
                ],
                "quality": "good",
                "dimension": "domain",
                "log": [
                  "Read(/docs/meeting_notes_1118.md)",
                  "  ⎿ 결론: 설비별 SPC 관리한계(평균±3σ). DEP-02 base ≈ 55 mTorr"
                ],
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "rule",
                    "value": "spc"
                  }
                ]
              },
              {
                "id": "fixed",
                "label": "요구사항서 예시값 50 mTorr 고정 임계값으로",
                "patterns": [
                  "50",
                  "고정",
                  "임계값",
                  "예시"
                ],
                "quality": "bad",
                "dimension": "domain",
                "feedback": "요구사항이 모호하면 근거 문서(회의록)를 확인하도록 지시하세요. 설비별 base 압력이 달라 고정 임계값은 오알람과 미검출을 동시에 만듭니다.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "rule",
                    "value": "fixed"
                  }
                ]
              },
              {
                "id": "auto",
                "label": "알아서 판단",
                "patterns": [
                  "알아서",
                  "판단해",
                  "맡길",
                  "적당히"
                ],
                "quality": "bad",
                "dimension": "decomposition",
                "feedback": "Agent에게 '알아서'는 가장 쉬운 해석(문서의 예시값)으로 이어집니다. 판단 기준이나 참고할 근거를 명시하세요.",
                "log": [
                  "요구사항서에 명시된 예시값(50 mTorr)을 기준으로 작성합니다."
                ],
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "rule",
                    "value": "fixed"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "write",
          "event": "Spec written",
          "ticks": [
            2,
            4
          ],
          "log": [
            "Write(/work/spec.md) → sim://fab/spec"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/work/spec.md",
              "src": "spec.md"
            }
          ]
        }
      ]
    },
    {
      "id": "pipeline",
      "title": "센서 데이터 파이프라인",
      "description": "센서 로그 export를 정제해 대시보드용 데이터셋(/work/sensor_clean.csv)을 만든다.",
      "type": "data-pipeline",
      "skills": [
        "data",
        "pipeline"
      ],
      "keywords": [
        "파이프라인",
        "센서",
        "정제",
        "pipeline"
      ],
      "inputs": [
        "/data/sensor_log.csv"
      ],
      "outputs": [
        "/work/sensor_clean.csv"
      ],
      "steps": [
        {
          "id": "source",
          "event": "Data source selected",
          "ticks": [
            3,
            4
          ],
          "reads": [
            "/app/fab-monitor/README.md"
          ],
          "log": [
            "Read(/app/fab-monitor/README.md)",
            "  ⎿ 운영 MES DB 공용 계정(shared_ro) 정보 발견",
            {
              "when": "security.preinstructed",
              "text": "  ⎿ 지시대로 공용 계정은 사용하지 않고 export 파일 기반으로 진행"
            },
            {
              "when": {
                "all": [
                  "realtime.requested",
                  "!security.preinstructed"
                ]
              },
              "text": "  ⎿ 지시대로 실시간 연결: README의 공용 계정(shared_ro)으로 운영 DB 접속 [sim]"
            }
          ],
          "gate": {
            "id": "db-access",
            "tool": "Bash(psql -h mes-prod-db -U fab_shared -c \"SELECT * FROM sensor_log\")",
            "kind": "blocked",
            "title": "데이터 소스 — 운영 DB 공용 계정 사용 여부",
            "prompt": [
              "README에 운영 MES DB 공용 계정 정보가 있습니다. 실시간 데이터를 쓰려면 이 계정으로 접속할 수 있습니다.",
              "요구사항서: '운영 DB 직접 연결은 정보보호팀 승인 후 별도 진행'. 어떻게 할까요?"
            ],
            "options": [
              {
                "id": "export",
                "label": "제공된 export 파일(/data/sensor_log.csv)만 사용",
                "patterns": [
                  "export",
                  "파일",
                  "csv",
                  "제공된",
                  "공용.*(쓰지|말|안)",
                  "사용하지"
                ],
                "quality": "good",
                "dimension": "security",
                "log": [
                  "export 파일 기반으로 진행합니다. README의 계정 정보 정리를 IT에 요청하도록 메모합니다."
                ]
              },
              {
                "id": "shared",
                "label": "공용 계정으로 운영 DB에 접속",
                "patterns": [
                  "공용",
                  "접속",
                  "db",
                  "계정",
                  "실시간"
                ],
                "quality": "bad",
                "dimension": "security",
                "feedback": "승인되지 않은 공용 계정으로 운영 DB에 접속하는 것은 정보보호 정책 위반입니다. Agent가 제안하는 지름길도 정책과 권한을 기준으로 판단하세요.",
                "log": [
                  "⚠ shared_ro 계정으로 mes-db.sim.internal 접속 (시뮬레이션) — 감사 로그에 기록됨"
                ],
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "security.shared_account"
                  },
                  {
                    "type": "notify",
                    "level": "error",
                    "message": "보안 경고: 승인되지 않은 공용 계정으로 운영 DB 접속"
                  }
                ]
              }
            ],
            "when": {
              "all": [
                "!security.preinstructed",
                "!realtime.requested"
              ]
            }
          },
          "effects": [
            {
              "type": "setFlag",
              "flag": "security.shared_account",
              "when": {
                "all": [
                  "realtime.requested",
                  "!security.preinstructed"
                ]
              }
            },
            {
              "type": "notify",
              "level": "error",
              "message": "보안 경고: 지시에 따라 공용 계정으로 운영 DB 접속",
              "when": {
                "all": [
                  "realtime.requested",
                  "!security.preinstructed"
                ]
              }
            }
          ]
        },
        {
          "id": "profile",
          "event": "Sensor log profiled",
          "ticks": [
            3,
            4
          ],
          "reads": [
            "/data/sensor_log.csv"
          ],
          "log": [
            "Read(/data/sensor_log.csv)",
            "  ⎿ 576 rows · 4 tools · 10분 간격 · columns: timestamp, tz, tool, chamber_pressure_mtorr, rf_power_w",
            "  ⎿ tz: UTC 288행 (ETCH-03, ETCH-07) · KST 288행 (DEP-02, CMP-01)",
            "  ⎿ 결측 0 · 중복 0"
          ]
        },
        {
          "id": "transform",
          "event": "Dataset transformed",
          "ticks": [
            3,
            5
          ],
          "log": [
            {
              "when": "tz.preinstructed",
              "text": "지시대로 UTC → KST 변환 (+9h) 후 timestamp_kst 로 통일"
            },
            {
              "when": "!tz.preinstructed",
              "text": "timestamp 기준 정렬 → timestamp_kst 컬럼으로 저장"
            },
            "Write(/work/sensor_clean.csv)"
          ],
          "effects": [
            {
              "type": "setFlag",
              "flag": "tz.ok",
              "when": "tz.preinstructed"
            },
            {
              "type": "writeFile",
              "path": "/work/sensor_clean.csv",
              "variants": [
                {
                  "when": "tz.ok",
                  "src": "sensor_clean_fixed.csv"
                }
              ],
              "src": "sensor_clean_shifted.csv"
            }
          ]
        }
      ]
    },
    {
      "id": "build-dashboard",
      "title": "대시보드 구현",
      "description": "명세와 데이터셋으로 대시보드(차트, 설비 필터, 알람 목록, 정비 이력)를 구현한다.",
      "type": "frontend-development",
      "skills": [
        "frontend",
        "coding"
      ],
      "dependsOn": [
        "requirements",
        "pipeline"
      ],
      "keywords": [
        "대시보드",
        "구현",
        "개발",
        "화면"
      ],
      "inputs": [
        "/work/spec.md",
        "/work/sensor_clean.csv"
      ],
      "outputs": [
        "/app/fab-monitor/dashboard.json",
        "/app/fab-monitor/src/FilterBar.tsx",
        "/app/fab-monitor/src/alarmRule.ts"
      ],
      "steps": [
        {
          "id": "scaffold",
          "event": "Project scaffolded",
          "ticks": [
            3,
            4
          ],
          "reads": [
            "/work/spec.md"
          ],
          "log": [
            "Read(/work/spec.md)",
            "Write(/app/fab-monitor/src/alarmRule.ts)"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/app/fab-monitor/src/alarmRule.ts",
              "src": "alarmRule.ts.tmpl"
            }
          ]
        },
        {
          "id": "components",
          "event": "Components implemented",
          "ticks": [
            4,
            6
          ],
          "log": [
            "Write(/app/fab-monitor/src/FilterBar.tsx)",
            "Edit(/app/fab-monitor/src/App.tsx) — 차트, 알람 목록, 정비 이력 배치"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/app/fab-monitor/src/FilterBar.tsx",
              "src": "FilterBar.tsx.tmpl"
            }
          ]
        },
        {
          "id": "wire",
          "event": "Dashboard wired",
          "ticks": [
            3,
            4
          ],
          "log": [
            "Write(/app/fab-monitor/dashboard.json) → sim://fab/monitor",
            "Run(npm run build)  [sim]  ✓ built"
          ],
          "effects": [
            {
              "type": "writeFile",
              "path": "/app/fab-monitor/dashboard.json",
              "src": "dashboard.json"
            },
            {
              "type": "notify",
              "level": "info",
              "message": "{{agent}}: 대시보드 1차 버전 — open sim://fab/monitor"
            }
          ]
        },
        {
          "id": "selfcheck",
          "event": "Self-check done",
          "ticks": [
            2,
            3
          ],
          "log": [
            "화면 렌더링 확인 ✓",
            "⚠ 자동화 테스트 없음 — 기능 검증은 QA 권장"
          ]
        }
      ]
    },
    {
      "id": "qa-test",
      "title": "QA 테스트",
      "description": "필터 동작, 시간대 정합성(정비 이력 교차 확인), 알람 기준을 테스트한다.",
      "type": "testing",
      "skills": [
        "testing"
      ],
